      private Dictionary<MenuOption, bool> selectionState = new Dictionary<MenuOption, bool>();

      public Menu()
      {
         foreach (MenuOption option in Enum.GetValues(typeof(MenuOption)))
         {
            selectionState[option] = false;
         }
      }

      public void ShowMenu()
      {
         Console.Clear();
         DisplayMenuOptions.Show(selectionState);

         Console.Write("Please select an option: ");
         if (Enum.TryParse<MenuOption>(Console.ReadLine(), out var selectedOption))
         {
            selectionState[selectedOption] = true; // Save the selection value as true
            ExecuteMenuAction(selectedOption);
         }
         else
         {
            Console.WriteLine("Invalid option. Please try again.");
            ShowMenu();
         }
      }

      private void ExecuteMenuAction(MenuOption option)
      {
         switch (option)
         {
            case MenuOption.GearBag:
               HandleGearBag();
               break;
            case MenuOption.Gloves:
               HandleGloves();
               break;
            case MenuOption.ChestProtector:
               HandleChestProtector();
               break;
            case MenuOption.NeckBrace:
               HandleNeckBrace();
               break;
            case MenuOption.HelmetBag:
               HandleHelmetBag();
               break;
            case MenuOption.Helmet:
               HandleHelmet();
               break;
            case MenuOption.GoggleBag:
               HandleGoggleBag();
               break;
            case MenuOption.Goggles:
               HandleGoggles();
               break;
            case MenuOption.GoggleReplacementLenses:
               HandleGoggleReplacementLenses();
               break;
            case MenuOption.GoggleTearOffs:
               HandleGoggleTearOffs();
               break;
            case MenuOption.GoggleRollOffs:
               HandleGoggleRollOffs();
               break;
            case MenuOption.GoggleAccessories:
               HandleGoggleAccessories();
               break;
            case MenuOption.KneeBraces:
               HandleKneeBraces();
               break;
            case MenuOption.KneeGuards:
               HandleKneeGuards();
               break;
            case MenuOption.ElbowGuards:
               HandleElbowGuards();
               break;
            case MenuOption.KidneyBelt:
               HandleKidneyBelt();
               break;
            case MenuOption.RaceBoots:
               HandleRaceBoots();
               break;
            case MenuOption.SelectAll:
               SelectAllOptions();
               break;
            case MenuOption.UnselectAll:
               UnselectAllOptions();
               break;
            case MenuOption.LogOut:
               MainMenu.ShowMainMenu();
               break;
            default:
               Console.WriteLine("Invalid option. Please try again.");
               ShowMenu();
               break;
         }
      }

      private async void HandleGearBag()
      {
         try
         {
            Gear_Bag gearBag = new Gear_Bag();
            // Toggle the selection state
            selectionState[MenuOption.GearBag] = !selectionState[MenuOption.GearBag];

            if (selectionState[MenuOption.GearBag])
            {
               Console.WriteLine("Gear Bag selected.");
               await LogSelectionAsync("Gear Bag selected.");
            }
            else
            {
               Console.WriteLine("Gear Bag unselected.");
               await LogSelectionAsync("Gear Bag unselected.");
            }
         }
         catch (Exception ex)
         {
            Console.WriteLine($"An error occurred: {ex.Message}");
         }
         finally
         {
            ShowMenu();
         }
      }

