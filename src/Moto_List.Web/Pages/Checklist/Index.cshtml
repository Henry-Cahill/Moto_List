@page
@model Moto_List.Web.Pages.Checklist.IndexModel
@{
    ViewData["Title"] = "My Checklist";
    var totalItems = Model.Items.Count;
    var packedItems = Model.Items.Count(i => i.IsChecked);
    var progressPercent = totalItems > 0 ? (int)Math.Round(100.0 * packedItems / totalItems) : 0;
}

<div class="checklist-header">
    <h2><i class="bi bi-list-check" style="color: var(--primary);"></i> My Checklist</h2>
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addItemModal">
        <i class="bi bi-plus-lg"></i> Add Item
    </button>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Your checklist is empty. Add items to get started!</p>
        <button class="btn btn-moto mt-3" data-bs-toggle="modal" data-bs-target="#addItemModal">
            <i class="bi bi-plus-lg"></i> Add Your First Item
        </button>
    </div>
}
else
{
    <div class="progress-summary">
        <span class="stat-badge packed">
            <i class="bi bi-check-circle-fill"></i> @packedItems Packed
        </span>
        <span class="stat-badge remaining">
            <i class="bi bi-circle"></i> @(totalItems - packedItems) Remaining
        </span>
        <div class="progress-bar-wrapper">
            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width: @(progressPercent)%"
                     aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
        <small style="color: var(--text-muted); font-weight: 600;">@progressPercent%</small>
    </div>

    @foreach (var group in Model.Items.GroupBy(i => i.CategoryName).OrderBy(g => g.Key))
    {
        <div class="category-card">
            <div class="category-header">
                <span><i class="bi bi-tag-fill me-1"></i> @group.Key</span>
                <span class="category-count">
                    @group.Count(i => i.IsChecked) / @group.Count()
                </span>
            </div>
            @foreach (var item in group.OrderBy(i => i.IsChecked).ThenBy(i => i.Name))
            {
                <div class="checklist-item @(item.IsChecked ? "checked" : "")">
                    <div class="item-content">
                        <form method="post" asp-page-handler="Toggle" class="d-inline">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="check-btn @(item.IsChecked ? "checked" : "")">
                                <i class="bi @(item.IsChecked ? "bi-check-lg" : "bi-square")"></i>
                            </button>
                        </form>
                        <div>
                            <span class="item-name @(item.IsChecked ? "done" : "")">@item.Name</span>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <br /><span class="item-desc">@item.Description</span>
                            }
                        </div>
                    </div>
                    <form method="post" asp-page-handler="Delete" class="d-inline">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <button type="submit" class="delete-btn"
                                onclick="return confirm('Remove this item?')">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    }
}

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Add">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-lg" style="color: var(--primary);"></i> Add New Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Item Name</label>
                        <input name="name" class="form-control" placeholder="e.g. Helmet, Gloves, Chain Lube..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Description <span style="color: var(--text-muted); font-weight: 400;">(optional)</span></label>
                        <input name="description" class="form-control" placeholder="Add a note..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Category</label>
                        <select name="categoryId" class="form-select" required>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-lg me-1"></i> Add Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
