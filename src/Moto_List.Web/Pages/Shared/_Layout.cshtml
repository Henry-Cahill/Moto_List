<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Moto List</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="font-family: 'Inter', sans-serif;">
    <nav class="navbar navbar-expand-lg navbar-moto">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <i class="bi bi-bicycle"></i> Moto List
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-auto align-items-center">
                    @if (Context.Session.GetString("JwtToken") != null)
                    {
                        <span class="navbar-text me-3">
                            <i class="bi bi-person-circle"></i> @Context.Session.GetString("Username")
                        </span>
                        <a class="nav-link" asp-page="/Checklist/Index">
                            <i class="bi bi-list-check"></i> My Checklist
                        </a>
                        <form method="post" asp-page="/Account/Logout" class="d-inline ms-2">
                            <button type="submit" class="btn btn-logout btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a class="nav-link" asp-page="/Account/Register">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="footer-moto">
        <div class="container">
            <p><i class="bi bi-bicycle"></i> &copy; @DateTime.Now.Year Moto List &mdash; Stay organized for your motocross adventure!</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
