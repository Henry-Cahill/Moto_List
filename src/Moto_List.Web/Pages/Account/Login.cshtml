@page
@model Moto_List.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center" style="margin-top: 4rem;">
    <div class="col-md-5 col-lg-4">
        <div class="auth-card card">
            <div class="card-body">
                <div class="auth-header">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <h3>Welcome Back</h3>
                    <p style="color: var(--text-muted); margin: 0;">Sign in to your account</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label">Username</label>
                        <input asp-for="Input.Username" class="form-control" placeholder="Enter your username" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <p class="text-center mt-3" style="color: var(--text-muted);">
                    Don't have an account? <a asp-page="/Account/Register" style="color: var(--primary); font-weight: 600;">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>
